APP_ENV=development
# Saldo de cuenta = cosmético/demo (PUT /api/account/balance).
# En non-prod el PUT se permite por defecto. En APP_ENV=production exige true:
ALLOW_CLIENT_BALANCE_EDIT=false
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
PUBLIC_APP_URL=
ADMIN_WEB_URL=https://yape-admin-panel.com
ADMIN_PROXY_SECRET=
AUTH_BOOTSTRAP_ENABLED=false
AUTH_BOOTSTRAP_SECRET=
# Restablecimiento temporal del Owner: actívalo solo durante la recuperación y vuelve a false después.
AUTH_OWNER_PASSWORD_RESET_ENABLED=false
AUTH_OWNER_TELEGRAM_ID=
AUTH_RATE_LIMIT_PEPPER=
AUTH_SESSION_IDLE_MINUTES=720
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_IDS=
TELEGRAM_BOT_USERNAME=
TELEGRAM_SUPPORT_USERNAME=
TELEGRAM_SUPPORT_USER_ID=
ACCOUNT_SMS_VALIDATION_TOKEN=
ACCOUNT_AUTO_VALIDATION_TOKEN=
# Los tokens de cuenta se validan por usuario: HMAC-SHA256(master, `${userId}:${kind}`)
# en hex (primeros 32 caracteres). El master debe tener al menos 32 caracteres.
QR_CONTACTS_ENCRYPTION_KEY=
TELEGRAM_REQUIRED_GROUP_ID=
TELEGRAM_GROUP_INVITE_URL=
