# Copia a .env.local y completa. Nunca subas secretos reales.

APP_ENV=development
DATABASE_PROVIDER=supabase
SUPABASE_DATABASE_URL=

PUBLIC_APP_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3002

# Secrets (≥32 caracteres en staging/producción)
ADMIN_PROXY_SECRET=
AUTH_RATE_LIMIT_PEPPER=
TOKEN_ENCRYPTION_SECRET=
QR_CONTACTS_ENCRYPTION_KEY=
CRON_SECRET=

# Opcional: pepper de contraseñas/PIN (hashes nuevos pbkdf2-sha256-p1)
# AUTH_PASSWORD_PEPPER=

AUTH_OWNER_TELEGRAM_ID=
AUTH_BOOTSTRAP_ENABLED=false
# AUTH_BOOTSTRAP_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_REQUIRED_GROUP_ID=
TELEGRAM_GROUP_INVITE_URL=https://t.me/
