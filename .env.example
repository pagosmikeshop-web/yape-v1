# Example server configuration. Never commit the real .env file.

# ===== RUNTIME =====
APP_ENV=development

# ===== DATABASE =====
# Keep Turso until the Supabase migration has been verified.
DATABASE_PROVIDER=turso
SUPABASE_DATABASE_URL=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ===== URLS =====
PUBLIC_APP_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3002

# ===== ADMIN =====
ADMIN_PROXY_SECRET=

# ===== AUTH =====
AUTH_BOOTSTRAP_ENABLED=false
AUTH_BOOTSTRAP_SECRET=
AUTH_OWNER_TELEGRAM_ID=
AUTH_RATE_LIMIT_PEPPER=
AUTH_SESSION_IDLE_MINUTES=30

# ===== TELEGRAM =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_IDS=
TELEGRAM_BOT_USERNAME=
TELEGRAM_SUPPORT_USERNAME=
TELEGRAM_SUPPORT_USER_ID=
TELEGRAM_REQUIRED_GROUP_ID=
TELEGRAM_GROUP_INVITE_URL=

# ===== INTEGRATIONS =====
ACCOUNT_SMS_VALIDATION_TOKEN=
ACCOUNT_AUTO_VALIDATION_TOKEN=
QR_CONTACTS_ENCRYPTION_KEY=
RECIPIENT_LOOKUP_PROVIDER=claro
RECIPIENT_LOOKUP_API_BASE_URL=https://api.anubisbot2.xyz/api/v1/claro
RECIPIENT_LOOKUP_API_TOKEN=

# ===== ONE-TIME MIGRATION =====
# Use only while migrating a local SQLite export; do not set in production.
SOURCE_SQLITE_FILE=
