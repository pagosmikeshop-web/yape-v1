{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "correctness": {
        "noUndeclaredVariables": "error",
        "noUnusedImports": "error"
      },
      "suspicious": {
        "noDuplicateObjectKeys": "error"
      }
    }
  },
  "files": {
    "includes": [
      "app/**/*.{ts,tsx}",
      "db/**/*.ts",
      "scripts/**/*.mjs",
      "tests/**/*.{mjs,ts,tsx}",
      "proxy.ts",
      "next.config.ts",
      "!**/.next/**",
      "!**/dist/**"
    ]
  }
}
