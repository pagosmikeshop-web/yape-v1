{
  "name": "yape-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "dev:cloudflare": "vinext dev",
    "build:cloudflare": "vinext build",
    "test": "npm run build:cloudflare && node --test tests/reconstruction.test.mjs tests/security.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "security:scan": "node scripts/security-scan.mjs",
    "security:audit": "npm audit --audit-level=high",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "5.2.0",
    "@tursodatabase/serverless": "1.3.1",
    "@zxing/browser": "^0.2.1",
    "drizzle-orm": "0.45.2",
    "html-to-image": "1.11.13",
    "lottie-web": "^5.13.0",
    "next": "16.2.11",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.46.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.113.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  },
  "type": "module"
}
