{
  "name": "yape-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build && node scripts/verify-public-build.mjs .next/static",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check app db scripts tests proxy.ts next.config.ts capacitor.config.ts --diagnostic-level=error",
    "test": "vitest run",
    "security:scan": "node scripts/security-scan.mjs",
    "security:audit": "npm audit --audit-level=high",
    "db:generate": "drizzle-kit generate",
    "db:migrate:supabase": "node scripts/import-sqlite-to-supabase.mjs --apply",
    "db:migrate:supabase:dry-run": "node scripts/import-sqlite-to-supabase.mjs",
    "db:verify:supabase": "node scripts/import-sqlite-to-supabase.mjs --verify-only",
    "cap:check:webdir": "node scripts/verify-capacitor-webdir.mjs out"
  },
  "dependencies": {
    "@capacitor/core": "8.4.2",
    "@fingerprintjs/fingerprintjs": "5.2.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@vercel/speed-insights": "^2.0.0",
    "@zxing/browser": "^0.2.1",
    "drizzle-orm": "0.45.2",
    "html-to-image": "1.11.13",
    "lottie-web": "^5.13.0",
    "next": "16.3.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@capacitor/cli": "8.4.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "nanoid": "^3.3.17",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "type": "module"
}
